{
  "name": "@joezhoujinjing/facet",
  "version": "0.8.0",
  "description": "Local SQLite SDK and CLI for agent analytics",
  "keywords": [
    "sqlite",
    "agent",
    "llm",
    "analytics",
    "sql",
    "local-first",
    "tools"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "facet": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "example": "npm run build && node examples/basic.mjs",
    "prepack": "npm run build",
    "benchmark": "npm run build && node bench/query.mjs"
  },
  "dependencies": {
    "@photostructure/sqlite": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheApeironLab/facet.git"
  },
  "homepage": "https://github.com/TheApeironLab/facet#readme",
  "bugs": {
    "url": "https://github.com/TheApeironLab/facet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
