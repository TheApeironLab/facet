{
  "name": "@local/facet",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "example": "npm run build && node examples/basic.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  },
  "description": "Local SQLite SDK and CLI for agent analytics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "facet": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheApeironLab/facet.git"
  }
}
